DATABASE_URL=postgres://reval:reval@localhost:5432/reval
PORTAL_URL=http://localhost:3000
PORT=4000

# "dev" = no Stripe; activate subscriptions with POST /portal/orgs/:orgId/billing/dev-activate
BILLING_MODE=dev
# Production refuses BILLING_MODE=dev unless this is true (testing deploys only; free activation for anyone).
# ALLOW_DEV_BILLING_IN_PRODUCTION=false
# For BILLING_MODE=stripe:
# STRIPE_SECRET_KEY=sk_test_...   (or STRIPE_PROD_STRIPE_SECRET_KEY from Vercel's Stripe integration)
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...

# Set to true when served over HTTPS
COOKIE_SECURE=false

# Hosted Postgres only: CA certificate (PEM; "\n" escapes allowed) to verify the server's TLS certificate.
# Without it, sslmode=require encrypts but does not verify (libpq semantics).
# DATABASE_CA_CERT=
