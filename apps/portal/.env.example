# The Fastify API. /portal/* is proxied here so the session cookie stays same-origin.
# Rewrites are fixed at build time: set this for `next build` too.
API_URL=http://localhost:4000

# Public base URL of the API, shown in "run it from your code" snippets. Optional: defaults to
# API_URL. Set it only if clients should use a different URL than the portal's proxy target.
# NEXT_PUBLIC_API_URL=http://localhost:4000
